# OnBoard API keys.
# Copy this file to OnBoard/Secrets.env and replace the values with your own keys
# from https://developer.trafiklab.se (one key per product). Secrets.env is
# git-ignored; the app falls back to this example file so the project builds
# and runs out of the box.
TRAFIKLAB_REALTIME_KEY=bogus-realtime-key-replace-me
TRAFIKLAB_RESROBOT_KEY=bogus-resrobot-key-replace-me
