    "About.DataMessage": {
      "comment": "Attribution for the data sources the app is built on.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Departures, trips, and stop data is provided by Trafiklab, the open data platform for Swedish public transport, operated by Samtrafiken."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trafiklab, Samtrafikenin ylläpitämä Ruotsin joukkoliikenteen avoin data-alusta, tarjoaa lähtö-, matka- ja pysäkkitiedot."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avgångar, resor och hållplatsdata tillhandahålls av Trafiklab, den öppna dataplattformen för svensk kollektivtrafik, som drivs av Samtrafiken."
          }
        }
      },
      "shouldGenerateSymbol": true
    },
    "About.Tagline": {
      "comment": "One-line description of the app on the About tab.",
      "extractionState": "manual",
