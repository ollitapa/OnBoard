    "Location.DeniedMessage": {
      "comment": "Message under the location-access-off title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We can't show stops near you. Search manually or turn on location access in Settings."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Emme voi näyttää pysäkkejä lähelläsi. Hae manuaalisesti tai ota sijainti käyttöön asetuksista."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kan inte visa hållplatser nära dig. Sök manuellt eller slå på platsåtkomst i Inställningar."
          }
        }
      },
      "shouldGenerateSymbol": true
    },
